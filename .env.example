# Discord Developer Portal에서 발급한 봇 토큰
DISCORD_TOKEN=replace-me

# 개발 중 명령을 즉시 동기화할 서버 ID. 운영에서는 비워 두면 전역 명령이 됩니다.
DEV_GUILD_ID=

# Supertonic 3 설정 (M1-M5, F1-F5)
TTS_VOICE=F1
TTS_LANGUAGE=ko
TTS_SPEED=1.05
TTS_STEPS=8
TTS_MAX_CHARS=500

# 사용자별 목소리 선택을 저장할 JSON 파일
VOICE_SETTINGS_PATH=data/voice_preferences.json

# 이모지 이미지를 다시 게시할 웹훅 이름
EMOJI_WEBHOOK_NAME=DotoriBot Emoji
